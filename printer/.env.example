# Rendered on the host by Ansible (deploy_docker_env -> printer.env.example).
# Do not commit real values here.

# Beszel agent (listen mode; reports to the hub on voyager)
BESZEL_AGENT_KEY=changeme

# CUPS web-UI / lpadmin admin login
CUPS_ADMIN_USER=print
CUPS_ADMIN_PASSWORD=changeme

# Declarative print queue (the cups-samba image creates it on first start)
PRINTER_NAME=Brother_Printer
PRINTER_URI=usb://Brother/HL-L2320D%20series?serial=U63877J0N376391
PRINTER_PPD=drv:///brlaser.drv/brl2320d.ppd
