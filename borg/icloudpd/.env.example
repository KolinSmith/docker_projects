# Copy to borg/icloudpd/.env on the host (next to docker-compose.yml) and fill
# in. Compose reads this file for ${...} interpolation. **/.env is gitignored.

TZ=America/Chicago

# The Apple ID to back up.
APPLE_ID=you@example.com

# Seconds between sync passes. 21600 = every 6 hours.
WATCH_INTERVAL=21600

# Host port for the icloudpd web UI (Apple ID password + 2FA entry / re-auth).
ICLOUDPD_WEBUI_PORT=8579
