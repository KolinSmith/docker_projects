# Borg monitoring stack secrets.
# Copy this file to .env on the box and fill in real values -- .env is gitignored,
# this .env.example is the only thing tracked in git. Matches the convention every
# other Borg service already uses (see e.g. ../borg-stack/beszel-agent/.env.example).

# Beszel agent key -- get from the Beszel hub UI (running on Voyager) after adding
# this system, or copy the existing value from borg-stack's current .env before
# removing those service blocks (Step 2 of the migration, Task 1).
BESZEL_AGENT_KEY=ssh-ed25519 AAAA...your-beszel-hub-key-here

# Same GPU UUID borg-stack's ErsatzTV/binhex-plexpass already use for passthrough --
# copy the real value from borg-stack/.env on the box, don't regenerate it.
NVIDIA_GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# APC Smart-UPS (SMT1500RM2U) AP9630 Network Management Card.
# UPS_SNMP_HOST isn't actually consumed by prometheus.yml -- Prometheus's own config
# format has no ${VAR} substitution, so the real IP is written as a literal there
# instead (see prometheus.yml's apc-ups job). Kept here for documentation/consistency
# with the rest of this file and in case a future templating step needs it.
UPS_SNMP_HOST=192.168.9.51

# NOT consumed by any file here either -- snmp.yml bakes the community string directly
# into its auths.public_v2 block (same reason: snmp_exporter's config format has no
# env-var indirection). Currently "public", which is the AP9630 card's unconfigured
# FACTORY DEFAULT, not a secret Kolin deliberately set. Flagged here for future
# hardening: set a real read-only community string on the card itself and update it in
# both places (the card's SNMP config UI and snmp.yml's auths block) when that happens.
UPS_SNMP_COMMUNITY=public
