      },
      "options": {}
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Onion skins dropped per second",
      "description": "Handshakes dropped, 5m rate by type. Any sustained drops mean CPU saturation.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (type) (rate(tor_relay_load_onionskins_total{action=\"dropped\"}[5m]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "ntor answered %",
      "description": "processed / (processed + dropped) over ntor and ntor_v3. Note: the ntor_v3 dropped counter may be undercounted, so the real answered ratio can be lower than shown.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(tor_relay_load_onionskins_total{type=~\"ntor|ntor_v3\",action=\"processed\"}[5m])) / (sum(rate(tor_relay_load_onionskins_total{type=~\"ntor|ntor_v3\",action=\"processed\"}[5m])) + sum(rate(tor_relay_load_onionskins_total{type=~\"ntor|ntor_v3\",action=\"dropped\"}[5m])))",
          "legendFormat": "answered",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.9,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
