    {
      "id": 9,
      "type": "timeseries",
      "title": "Read / written bytes per second",
      "description": "Relay throughput (5m rate of tor_relay_traffic_bytes by direction). Red threshold line at 3072000 B/s, the 3000 KBytes RelayBandwidthRate limit.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(tor_relay_traffic_bytes[5m])",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3072000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
