#!/bin/sh
#
# gstopdf — local override of the cups-filters PostScript->PDF prefilter.
#
# Why this file exists
# --------------------
# The stock /usr/lib/cups/filter/gstopdf shipped by cups-filters is a one-line
# wrapper that just execs `gstoraster` with OUTFORMAT=PDF. `gstoraster`, for
# PostScript input, first runs a Ghostscript bounding-box detection pass:
#
#     gs -q -dNOPAUSE -dBATCH -sDEVICE=bbox \
#        -dDEVICEWIDTHPOINTS=1 -dDEVICEHEIGHTPOINTS=1 <spoolfile>
#
# On the form-heavy PostScript macOS emits when an app prints a fillable PDF
# through Apple's `cgpdftops` filter (AcroForm fields rendered as many small
# scaled image/shading/pattern ops), that bbox pass hits a Ghostscript
# pathology and spins at 100% CPU indefinitely on the Pi 3B this image runs on.
# The job never leaves "Sending data to printer". Plain-PDF jobs are unaffected
# because gstoraster reads the MediaBox directly and skips the bbox pass.
#
# The actual render (`gs -sDEVICE=cups`) handles the same file in ~2s, so the
# hardware is fine — only the bbox pre-pass is broken. This override does the
# PS->PDF conversion with plain Ghostscript `pdfwrite` (no bbox pass); the
# resulting PDF then goes through the normal pdftopdf -> gstoraster ->
# rastertobrlaser chain, which works.
#
# COPY root/ / runs after `apt-get install cups-filters` in the Dockerfile, so
# this file wins over the packaged one. Revisit if cups-filters ever fixes the
# bbox pass or gstopdf stops delegating to gstoraster.
#
# Filter contract: gstopdf job-id user title copies options [file]
# reads PostScript from $6 (if given) or stdin, writes PDF to stdout.

echo "DEBUG: gstopdf (cups-samba local override) argv[$#] = $@" >&2
echo "DEBUG: PPD: $PPD" >&2

if [ $# -lt 5 ] || [ $# -gt 6 ]; then
    echo "ERROR: gstopdf job-id user title copies options [file]" >&2
    exit 1
fi

# Read from the given file rather than stdin when CUPS passes one.
if [ -n "$6" ]; then
    exec <"$6"
fi

exec gs -q -dNOPAUSE -dBATCH -dSAFER -dNOINTERPOLATE \
        -dAutoRotatePages=/None -dCompatibilityLevel=1.5 \
        -sDEVICE=pdfwrite -sOutputFile=- -
