# Pi-hole DS9 Docker Environment Variables
# Real values come from Ansible vault via roles/deploy_docker_env (never commit a real .env)

PIHOLE_WEBPASSWORD=your_pihole_web_password_here
PIHOLE_UPSTREAM_DNS=your_upstream_dns_ip_here
PIHOLE_REV_SERVER_CIDR=your_lan_cidr_here
PIHOLE_REV_SERVER_TARGET=your_router_ip_here
PIHOLE_REV_SERVER_DOMAIN=your_router_domain_here
PIHOLE_VIRTUAL_HOST=your_pihole_hostname_here
BESZEL_AGENT_KEY=your_beszel_agent_key_here
